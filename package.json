{
  "name": "stock-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local:init": "wrangler d1 execute stock_sim --local --file=./database/bootstrap.sql",
    "db:local": "wrangler d1 migrations apply stock_sim --local",
    "db:remote": "wrangler d1 migrations apply stock_sim --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
